{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"], // Browser APIs
    "module": "ESNext", // For Vite/Modern browsers
    "moduleResolution": "bundler", // For Vite
    "jsx": "react-jsx", // React specific
    "noEmit": true, // Vite handles the building
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    // TypeScript 7 no longer auto-includes every visible @types/* package, so the
    // set has to be named explicitly (it was implicit under TS <=6).
    //   node                    -> `process` + the NodeJS.* namespace
    // See docs/ts7-upgrade-audit.md §4.2. Types reached through imports resolve
    // normally and do not belong here.
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": ["src", "premium/src"], // React source files and optional premium components
  "references": [{ "path": "./tsconfig.node.json" }]
}
